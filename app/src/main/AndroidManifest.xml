<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Only for checking GitHub for a newer DocNest and installing it. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- For making a long PDF while DocNest is in the background or the phone is locked: the
         service that keeps the work going, its progress and "PDF ready" notifications, and
         keeping the processor on until the PDF is done. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DocNest">

        <!-- Home: My documents. -->
        <activity
            android:name=".DocumentsActivity"
            android:exported="false" />

        <!-- The launcher's entry. It keeps the name of the old first screen, so home-screen
             shortcuts made before My documents became the first screen still work. -->
        <activity-alias
            android:name=".MainActivity"
            android:exported="true"
            android:targetActivity=".DocumentsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Hold the app icon: Scan and Photos, straight away. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity-alias>

        <!-- A scan before it is saved. Turning the phone must not restart the screen, or photos
             being added would be lost. Photos shared from other apps (Gallery, WhatsApp…) come
             here, so it is open to other apps; it takes only their content (see sharedImages).
             singleTask: one of it, in DocNest's task, however it is opened. -->
        <activity
            android:name=".ReviewActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:parentActivityName=".DocumentsActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Cropping one page. Always dark, like the camera. -->
        <activity
            android:name=".CropActivity"
            android:exported="false"
            android:theme="@style/Theme.DocNest.Dark" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Locked to portrait; the shot's real orientation comes from the motion sensor. -->
        <activity
            android:name=".CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.DocNest.Camera" />

        <!-- Runs while a PDF is being made (see PdfJob). -->
        <service
            android:name=".PdfService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Ask Play services to fetch the text-recognition model when DocNest is installed. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
