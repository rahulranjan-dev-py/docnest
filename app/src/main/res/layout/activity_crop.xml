<?xml version="1.0" encoding="utf-8"?>
<!-- Crop one page: drag the corners to the page's edges. Always dark, like the camera. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeBtn"
            style="@style/Widget.DocNest.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Cancel"
            app:icon="@drawable/ic_close"
            app:iconTint="#FFFFFF" />

        <TextView
            android:id="@+id/cropTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <com.docnest.app.CropView
        android:id="@+id/cropView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Page outline. Drag its four corners to the edges of the page." />

    <TextView
        android:id="@+id/cropHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:text="Drag the corners to the edges of the page."
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="#C9D2CD" />

    <!-- baselineAligned off: with large system text a label can wrap and push its button down. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wholeBtn"
            style="@style/Widget.DocNest.DockButton.OnDark"
            android:layout_width="0dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:text="Whole photo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/applyBtn"
            style="@style/Widget.DocNest.DockButton"
            android:layout_width="0dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:text="Done"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
