<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/SettingsLabel"
            android:text="FILE SIZE" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/qualityGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qSmall"
                style="@style/SettingsChoice"
                android:text="Small\nfor email" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qStandard"
                style="@style/SettingsChoice"
                android:text="Standard\nclear text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qHigh"
                style="@style/SettingsChoice"
                android:text="High\nsharpest" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/SettingsLabel"
            android:text="COLOUR" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/colorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cColour"
                style="@style/SettingsChoice"
                android:text="Colour" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cGrey"
                style="@style/SettingsChoice"
                android:text="Black &amp; white\nsmaller file" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/SettingsLabel"
            android:text="PAGE" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/pageGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pA4"
                style="@style/SettingsChoice"
                android:text="A4 sheet\nprints well" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pPhoto"
                style="@style/SettingsChoice"
                android:text="Photo size\nno white border" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            style="@style/SettingsLabel"
            android:text="FILE NAME" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/nameBox"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:suffixText=".pdf">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nameIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/footOn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Print footer on every page" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your text (optional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/footIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Prints your text, today’s date and “Page 3 of 48”. English letters and numbers only."
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
